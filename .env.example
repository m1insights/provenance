# Copy to .env and fill in. Never commit .env.

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=sentinel-505814
GOOGLE_CLOUD_LOCATION=us-central1

# --- Gemini ---------------------------------------------------------------
# Two ways in, pick one.
#
# (a) Vertex AI -- preferred. Ties usage to the project and needs no key file.
#     Run `gcloud auth application-default login` first.
GOOGLE_GENAI_USE_VERTEXAI=true
#
# (b) Gemini API -- an AI Studio key. Leave USE_VERTEXAI unset if you use this.
# GOOGLE_API_KEY=

# --- Literature sources ---------------------------------------------------
# Optional. Raises the NCBI rate limit from 3/s to 10/s.
PUBMED_API_KEY=
PUBMED_EMAIL=info@m1labs.io

# --- GitHub ---------------------------------------------------------------
# Needs `repo` scope on the subject repository. Used to open issues and DRAFT
# pull requests. There is deliberately no merge capability in the toolset.
GITHUB_TOKEN=
SYNQOLOGY_GITHUB_REPO=

# --- Output ---------------------------------------------------------------
CREATIVE_BUCKET=sentinel-505814-provenance-creatives

# Set to 1 to run the whole pipeline without writing to GitHub or Cloud Storage.
PROVENANCE_DRY_RUN=
